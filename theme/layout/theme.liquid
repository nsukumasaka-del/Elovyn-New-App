<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%} Browser tab icon: use favicon if set, otherwise use store logo from Header settings {%- endcomment -%}
    {%- assign tab_icon = settings.favicon | default: settings.header_logo -%}
    {%- if tab_icon != blank -%}
      <link rel="icon" type="image/png" href="{{ tab_icon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ tab_icon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {%- if settings.type_header_font and settings.type_body_font -%}
      {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
        <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {%- endunless -%}
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags.join(', ') }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}

    {%- if settings.type_body_font -%}
      {%- liquid
        assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
        assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
        assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
      -%}
    {%- endif -%}

    {% style %}
      {%- if settings.type_body_font -%}
        {{ settings.type_body_font | font_face: font_display: 'swap' }}
        {%- if body_font_bold -%}{{ body_font_bold | font_face: font_display: 'swap' }}{%- endif -%}
        {%- if body_font_italic -%}{{ body_font_italic | font_face: font_display: 'swap' }}{%- endif -%}
        {%- if body_font_bold_italic -%}{{ body_font_bold_italic | font_face: font_display: 'swap' }}{%- endif -%}
      {%- endif -%}
      {%- if settings.type_header_font -%}
        {{ settings.type_header_font | font_face: font_display: 'swap' }}
      {%- endif -%}

      :root {
        {%- if settings.type_body_font -%}
          --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
          --font-body-style: {{ settings.type_body_font.style }};
          --font-body-weight: {{ settings.type_body_font.weight }};
        {%- endif -%}
        {%- if settings.type_header_font -%}
          --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
          --font-heading-style: {{ settings.type_header_font.style }};
          --font-heading-weight: {{ settings.type_header_font.weight }};
        {%- endif -%}
        {%- if settings.page_width -%}--font-page-width: {{ settings.page_width | divided_by: 10 }}rem;{%- endif -%}
        {%- if settings.body_scale -%}--font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};{%- endif -%}
        {%- if settings.heading_scale and settings.body_scale -%}--font-heading-scale: {{ settings.heading_scale | times: 1.0 | divided_by: settings.body_scale }};{%- endif -%}
        {%- if settings.brand_primary_color -%}--brand-primary-color: {{ settings.brand_primary_color }};{%- endif -%}
        {%- if settings.brand_secondary_color -%}--brand-secondary-color: {{ settings.brand_secondary_color }};{%- endif -%}
        {%- if settings.brand_background_color -%}--brand-background-color: {{ settings.brand_background_color }};{%- endif -%}
        {%- if settings.brand_text_color -%}--brand-text-color: {{ settings.brand_text_color }};{%- endif -%}
        {%- if settings.button_corner_radius -%}--brand-button-radius: {{ settings.button_corner_radius }}px;{%- endif -%}
        {%- if settings.section_vertical_spacing -%}--brand-section-spacing: {{ settings.section_vertical_spacing }}px;{%- endif -%}
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  </head>

  <body class="gradient template-{{ template.name | replace: '.', '-' }} theme-button-{{ settings.button_style | default: 'rounded' }}">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% comment %}
      HEADER (OS 2.0): `header-group.json` loads announcement-bar + site-header. This is the correct pattern — do not add {% section 'site-header' %} here or you will duplicate the header.
      Configure: Theme editor → Header group.
    {% endcomment %}
    <div class="layout-header-wrapper" id="layout-header-wrapper" data-header-mount>
      {% sections 'header-group' %}
    </div>

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% section 'cart-drawer' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        cart_js_url: '{{ routes.cart_url }}'.replace(/\/cart\/?(\?.*)?$/i, '') + '/cart.js',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };

      window.updateCartCount = function() {
        var url = (window.routes && window.routes.cart_js_url) || ((window.routes && window.routes.cart_url) || '/cart').replace(/\/cart\/?(\?.*)?$/i, '') + '/cart.js';
        fetch(url, { method: 'GET', credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            var count = (cart && typeof cart.item_count !== 'undefined') ? cart.item_count : 0;
            document.querySelectorAll('[data-cart-count]').forEach(function(el) {
              el.textContent = count;
              el.classList.toggle('elovyn-cart-badge--empty', count === 0);
              el.setAttribute('aria-hidden', count === 0 ? 'true' : 'false');
            });
          })
          .catch(function() {});
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`
      }

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
      }
    </script>

    {% comment %}
      CRO: Documented DOM hook for email capture / popup apps (Klaviyo, Omnisend, etc.).
      Many apps use Shopify app embeds instead; this slot is optional for custom scripts or app blocks.
    {% endcomment %}
    <div id="theme-email-popup-slot" class="visually-hidden" aria-hidden="true" data-email-popup-slot></div>
  </body>
</html>
