{%- assign rec_intent = intent | default: 'related' -%}
{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <section class="elite-product-recommendations section-spacing">
    <div class="container">
      <h2 class="elite-product-recommendations__title">{{ heading | default: 'You may also like' }}</h2>
      <div class="elite-product-recommendations__grid">
        {%- assign shown_count = 0 -%}
        {%- for p in recommendations.products -%}
          {%- if p.available == false -%}{%- continue -%}{%- endif -%}
          <article class="elite-product-recommendations__card">
            <a href="{{ p.url }}" class="elite-product-recommendations__image">
              {%- if p.featured_image != blank -%}
                <img src="{{ p.featured_image | image_url: width: 700 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" loading="lazy" width="{{ p.featured_image.width }}" height="{{ p.featured_image.height }}">
              {%- endif -%}
            </a>
            <a href="{{ p.url }}" class="elite-product-recommendations__name">{{ p.title }}</a>
            <span class="elite-product-recommendations__price">{{ p.price | money }}</span>
          </article>
          {%- assign shown_count = shown_count | plus: 1 -%}
          {%- if shown_count >= 4 -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif product != blank -%}
  <div
    class="elite-product-recommendations__loader"
    data-recommendations-root
    data-product-id="{{ product.id }}"
    data-limit="4"
    data-intent="{{ rec_intent }}"
  ></div>
  <script>
    (function(){
      var root = document.querySelector('[data-recommendations-root][data-product-id="{{ product.id }}"]');
      if(!root) return;
      var id = root.getAttribute('data-product-id');
      var limit = root.getAttribute('data-limit') || '4';
      var intent = root.getAttribute('data-intent') || 'related';
      var url = '/recommendations/products?section_id={{ section.id }}&product_id=' + encodeURIComponent(id) + '&limit=' + encodeURIComponent(limit) + '&intent=' + encodeURIComponent(intent);
      fetch(url, { credentials:'same-origin' })
        .then(function(r){ return r.text(); })
        .then(function(html){
          var tmp = document.createElement('div');
          tmp.innerHTML = html;
          var section = tmp.querySelector('.elite-product-recommendations');
          if(section){ root.replaceWith(section); }
        })
        .catch(function(){});
    })();
  </script>
{%- endif -%}

<style>
  .elite-product-recommendations__title{margin:0 0 .9rem;text-transform:uppercase;font-size:clamp(1.2rem,3vw,1.8rem)}
  .elite-product-recommendations__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  @media(min-width:980px){.elite-product-recommendations__grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:1.2rem}}
  .elite-product-recommendations__image{display:block;aspect-ratio:4/5;overflow:hidden}
  .elite-product-recommendations__image img{width:100%;height:100%;object-fit:cover;display:block}
  .elite-product-recommendations__name{display:block;margin:.55rem 0 .2rem;color:#000;text-decoration:none}
  .elite-product-recommendations__name:hover{text-decoration:underline}
  .elite-product-recommendations__price{font-weight:700}
</style>
