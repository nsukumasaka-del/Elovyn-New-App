<section class="image-banner-flex section-spacing">
  <div class="container mx-auto px-6">
    <div class="image-banner-flex__wrap">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 2200 }}" alt="{{ section.settings.heading | default: shop.name | escape }}" class="image-banner-flex__image" loading="lazy">
      {%- endif -%}
      <div class="image-banner-flex__overlay"></div>
      <div class="image-banner-flex__content">
        <h2>{{ section.settings.heading | default: 'Premium streetwear made to stand out' }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="image-banner-flex__btn">{{ section.settings.button_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .image-banner-flex__wrap { position: relative; min-height: 340px; border-radius: 16px; overflow: hidden; }
  .image-banner-flex__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .image-banner-flex__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.55), rgba(0,0,0,0.2)); }
  .image-banner-flex__content { position: relative; z-index: 1; color: #fff; padding: clamp(1.25rem, 4vw, 3rem); max-width: 640px; }
  .image-banner-flex__content h2 { margin: 0 0 0.65rem 0; font-size: clamp(1.65rem, 4vw, 3rem); line-height: 1.1; }
  .image-banner-flex__content p { margin: 0 0 1rem 0; color: rgba(255,255,255,0.9); }
  .image-banner-flex__btn { text-decoration: none; background: var(--color-accent, #FF3333); color: #fff; padding: 0.7rem 1rem; border-radius: 10px; display: inline-flex; font-weight: 700; }
</style>

{% schema %}
{
  "name": "Image banner (flex)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Premium streetwear made to stand out" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Use this section to highlight a campaign, drop, or value proposition." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Image banner (flex)" }
  ]
}
{% endschema %}
