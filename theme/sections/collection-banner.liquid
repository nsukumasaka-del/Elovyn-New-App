<section class="elite-collection-banner section-spacing">
  <div class="container">
    <div class="elite-collection-banner__grid">
      {% for block in section.blocks %}
        <a class="elite-collection-banner__card" href="{{ block.settings.collection.url | default: '/collections/all' }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
          {% elsif block.settings.collection != blank and block.settings.collection.featured_image != blank %}
            <img src="{{ block.settings.collection.featured_image | image_url: width: 1200 }}" alt="{{ block.settings.collection.title | escape }}" loading="lazy" width="{{ block.settings.collection.featured_image.width }}" height="{{ block.settings.collection.featured_image.height }}">
          {% endif %}
          <span class="elite-collection-banner__shade"></span>
          <span class="elite-collection-banner__meta">
            <strong>{{ block.settings.title | default: block.settings.collection.title | default: "Collection" }}</strong>
            <em>{{ block.settings.cta_text | default: "Shop now" }}</em>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .elite-collection-banner__grid{display:grid;grid-template-columns:1fr;gap:1rem}
  @media (min-width: 768px){.elite-collection-banner__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}}
  .elite-collection-banner__card{position:relative;display:block;min-height:280px;overflow:hidden;text-decoration:none;color:#fff}
  .elite-collection-banner__card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s ease}
  .elite-collection-banner__card:hover img{transform:scale(1.04)}
  .elite-collection-banner__shade{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.58),rgba(0,0,0,.18))}
  .elite-collection-banner__meta{position:absolute;left:1rem;right:1rem;bottom:1rem;display:flex;align-items:center;justify-content:space-between;gap:.75rem}
  .elite-collection-banner__meta strong{font-size:clamp(1rem,2.3vw,1.35rem);text-transform:uppercase}
  .elite-collection-banner__meta em{font-style:normal;text-transform:uppercase;font-size:.75rem;letter-spacing:.08em;border-bottom:1px solid rgba(255,255,255,.75)}
</style>

{% schema %}
{
  "name": "Collection banner",
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image (optional)" },
        { "type": "text", "id": "title", "label": "Title override", "default": "Collection" },
        { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop now" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Collection banner", "blocks": [{ "type": "collection_card" }, { "type": "collection_card" }] }]
}
{% endschema %}
