{% comment %}
  Premium trust messaging (text-only):
  - Top trust bar (for placement right under header)
  - Main trust grid block (for placement below featured products)
{% endcomment %}

<section class="trust-minimal" id="shopify-section-{{ section.id }}">
  {% if section.settings.show_top_bar %}
    <div class="trust-minimal__topbar" role="note" aria-label="Store trust messages">
      <div class="trust-minimal__topbar-inner">
        {{ section.settings.top_bar_text | default: "Free shipping over R500 • Easy 14-day returns • Secure checkout" }}
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_main %}
    <div class="trust-minimal__main">
      <div class="trust-minimal__container">
        <h2 class="trust-minimal__heading">{{ section.settings.heading | default: "Why shop with us" }}</h2>
        <p class="trust-minimal__subheading">{{ section.settings.subheading | default: "Fast shipping, easy returns, and secure checkout on every order." }}</p>

        <div class="trust-minimal__grid" role="list">
          {% for block in section.blocks %}
            {% if block.type == 'column' %}
              <article class="trust-minimal__col" role="listitem" {{ block.shopify_attributes }}>
                <h3 class="trust-minimal__title">{{ block.settings.title }}</h3>
                <p class="trust-minimal__desc">{{ block.settings.description }}</p>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
</section>

<style>
  .trust-minimal__topbar {
    min-height: 34px;
    background: #f7f7f7;
    border-bottom: 1px solid #eaeaea;
    color: #666;
    font-size: 12.5px;
    letter-spacing: 0.05em;
    line-height: 1.3;
  }
  .trust-minimal__topbar-inner {
    max-width: 1300px;
    margin: 0 auto;
    padding: 9px 16px;
    text-align: center;
  }

  .trust-minimal__main {
    padding: 80px 0;
    background: #fff;
  }
  .trust-minimal__container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .trust-minimal__heading {
    margin: 0 0 10px;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.15;
    color: #111;
    text-align: left;
  }
  .trust-minimal__subheading {
    margin: 0 0 50px;
    font-size: 16px;
    line-height: 1.5;
    color: #777;
    text-align: left;
    max-width: 760px;
  }
  .trust-minimal__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 48px;
  }
  .trust-minimal__title {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
    transition: color 0.2s ease;
    text-align: left;
  }
  .trust-minimal__desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: #777;
    transition: color 0.2s ease;
    text-align: left;
  }
  .trust-minimal__col:hover .trust-minimal__title { color: #111; }
  .trust-minimal__col:hover .trust-minimal__desc { color: #555; }

  @media (max-width: 1023px) {
    .trust-minimal__main { padding: 68px 0; }
    .trust-minimal__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 42px; }
  }
  @media (max-width: 767px) {
    .trust-minimal__main { padding: 56px 0; }
    .trust-minimal__heading { font-size: 26px; }
    .trust-minimal__subheading { margin-bottom: 36px; font-size: 15px; }
    .trust-minimal__grid { grid-template-columns: 1fr; gap: 30px; }
    .trust-minimal__topbar { font-size: 12px; }
  }
</style>

{% schema %}
{
  "name": "Trust minimal",
  "settings": [
    { "type": "checkbox", "id": "show_top_bar", "label": "Show top trust bar", "default": true },
    { "type": "text", "id": "top_bar_text", "label": "Top bar text", "default": "Free shipping over R500 • Easy 14-day returns • Secure checkout" },
    { "type": "checkbox", "id": "show_main", "label": "Show main trust section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why shop with us" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Fast shipping, easy returns, and secure checkout on every order." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Trust column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Fast dispatch" },
        { "type": "text", "id": "description", "label": "Description", "default": "Orders ship within 1–3 business days." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Trust minimal",
      "blocks": [
        { "type": "column", "settings": { "title": "Fast dispatch", "description": "Orders ship within 1–3 business days." } },
        { "type": "column", "settings": { "title": "Easy returns", "description": "Hassle-free returns within 14 days." } },
        { "type": "column", "settings": { "title": "Secure checkout", "description": "Encrypted payments you can trust." } },
        { "type": "column", "settings": { "title": "Quality first", "description": "Curated pieces built for everyday wear." } }
      ]
    }
  ]
}
{% endschema %}
