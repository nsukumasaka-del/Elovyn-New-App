{% comment %}
  List collections section - for /collections page
{% endcomment %}

<section class="py-16 md:py-24 bg-background">
  <div class="container mx-auto px-6">
    <h1 class="text-4xl md:text-5xl font-bold text-foreground mb-12">{{ 'collections.general.title' | t | default: 'Collections' }}</h1>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' %}
          <a href="{{ collection.url }}" class="group block rounded-2xl overflow-hidden border border-border/30 hover:border-accent/50 transition-colors">
            {% if collection.featured_image != blank %}
              <img src="{{ collection.featured_image | image_url: width: 400 }}" alt="{{ collection.featured_image.alt | escape }}" class="w-full aspect-[4/5] object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'w-full aspect-[4/5] object-cover' }}
            {% endif %}
            <div class="p-4 bg-card">
              <h2 class="font-bold text-foreground group-hover:text-accent transition-colors">{{ collection.title }}</h2>
              {% if collection.products_count > 0 %}
                <p class="text-sm text-foreground/60 mt-1">{{ collection.products_count }} {{ 'collections.general.products' | t | default: 'products' }}</p>
              {% endif %}
            </div>
          </a>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</section>
