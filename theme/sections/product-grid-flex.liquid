<section class="product-grid-flex section-spacing product-grid-flex--layout-{{ section.settings.layout | default: 'grid' }}" data-section-id="{{ section.id }}">
  <div class="container mx-auto px-6">
    {%- if section.settings.heading != blank -%}
      <div class="product-grid-flex__head text-center mb-8 md:mb-12">
        <h2 class="product-grid-flex__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="product-grid-flex__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign selected_collection = collections[section.settings.collection] -%}
    {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
      <div class="product-grid-flex__track {% if section.settings.layout == 'horizontal' %}product-grid-flex__track--horizontal{% endif %}">
        {%- for product in selected_collection.products limit: section.settings.products_to_show -%}
          <article class="product-grid-flex__card" data-product-id="{{ product.id }}">
            <a href="{{ product.url }}" class="product-grid-flex__image-link">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'product-grid-flex__placeholder' }}
              {%- endif -%}
              <span class="product-grid-flex__quick-overlay" aria-hidden="true"></span>
            </a>
            <div class="product-grid-flex__body">
              <a href="{{ product.url }}" class="product-grid-flex__title">{{ product.title }}</a>
              <div class="product-grid-flex__price">{{ product.price | money }}</div>
              <div class="product-grid-flex__actions">
                {%- if section.settings.enable_quick_add -%}
                  {%- if product.available -%}
                    {%- if product.has_only_default_variant -%}
                      <button
                        type="button"
                        class="product-grid-flex__quick-add"
                        data-quick-add
                        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        data-product-url="{{ product.url }}"
                      >
                        {{ section.settings.quick_add_label | default: 'Quick add' }}
                      </button>
                    {%- else -%}
                      <a href="{{ product.url }}" class="product-grid-flex__quick-add product-grid-flex__quick-add--link">
                        {{ section.settings.choose_options_label | default: 'Choose options' }}
                      </a>
                    {%- endif -%}
                  {%- else -%}
                    <span class="product-grid-flex__soldout">{{ 'products.product.sold_out' | t }}</span>
                  {%- endif -%}
                {%- endif -%}
                <a href="{{ product.url }}" class="product-grid-flex__secondary">{{ section.settings.button_text | default: 'View' }}</a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.settings.show_view_all and selected_collection.url != blank -%}
        <div class="text-center mt-10">
          <a href="{{ selected_collection.url }}" class="product-grid-flex__view-all">{{ section.settings.view_all_text | default: 'View all' }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="text-center product-grid-flex__empty">Choose a collection with products in the section settings.</p>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.enable_quick_add -%}
  <script>
    (function() {
      var root = document.querySelector('[data-section-id="{{ section.id }}"]');
      if (!root) return;
      var cartAddBase = (window.routes && window.routes.cart_add_url) || '/cart/add';
      var addUrl = cartAddBase.replace(/\/add\/?(\?.*)?$/i, '') + '/add.js';
      root.querySelectorAll('[data-quick-add]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var id = btn.getAttribute('data-variant-id');
          if (!id || btn.disabled) return;
          btn.disabled = true;
          var prev = btn.textContent;
          btn.textContent = '…';
          var fd = new FormData();
          fd.append('id', id);
          fd.append('quantity', '1');
          fetch(addUrl, { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
            .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, d: d }; }); })
            .then(function(res) {
              if (res.ok && typeof window.updateCartCount === 'function') window.updateCartCount();
              btn.textContent = res.ok ? {{ section.settings.quick_add_done_label | default: 'Added' | json }} : prev;
              if (res.ok) setTimeout(function() { btn.textContent = prev; btn.disabled = false; }, 1600);
              else btn.disabled = false;
            })
            .catch(function() { btn.textContent = prev; btn.disabled = false; });
        });
      });
    })();
  </script>
{%- endif -%}

<style>
  .product-grid-flex__heading {
    font-family: var(--font-heading-family, system-ui, sans-serif);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
    color: hsl(var(--foreground));
  }
  .product-grid-flex__sub {
    margin: 0 auto;
    max-width: 32rem;
    font-size: 0.9375rem;
    color: hsl(var(--foreground) / 0.6);
    line-height: 1.55;
  }
  .product-grid-flex__track {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .product-grid-flex__track:not(.product-grid-flex__track--horizontal) {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }
  @media (min-width: 1024px) {
    .product-grid-flex__track:not(.product-grid-flex__track--horizontal) {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
  }
  .product-grid-flex__track--horizontal {
    display: flex;
    flex-wrap: nowrap;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 1rem;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.75rem;
    margin: 0 -0.5rem;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }
  .product-grid-flex__track--horizontal .product-grid-flex__card {
    flex: 0 0 min(260px, 78vw);
    scroll-snap-align: start;
    max-width: 300px;
  }
  @media (min-width: 768px) {
    .product-grid-flex__track--horizontal .product-grid-flex__card {
      flex-basis: min(280px, 40vw);
    }
  }
  .product-grid-flex__card {
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border) / 0.35);
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .product-grid-flex__card:hover {
    border-color: hsl(var(--border) / 0.8);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
  }
  .product-grid-flex__image-link {
    display: block;
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    background: #f4f4f4;
  }
  .product-grid-flex__image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .product-grid-flex__card:hover .product-grid-flex__image-link img {
    transform: scale(1.04);
  }
  .product-grid-flex__quick-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    transition: background 0.3s ease;
    pointer-events: none;
  }
  .product-grid-flex__card:hover .product-grid-flex__quick-overlay {
    background: rgba(0, 0, 0, 0.06);
  }
  .product-grid-flex__body {
    padding: 1rem 0.9rem 1.1rem;
  }
  .product-grid-flex__title {
    color: hsl(var(--foreground));
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .product-grid-flex__title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .product-grid-flex__price {
    margin-top: 0.4rem;
    font-weight: 700;
    font-size: 0.9375rem;
    color: hsl(var(--foreground));
  }
  .product-grid-flex__actions {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .product-grid-flex__quick-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    width: 100%;
    padding: 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: none;
    background: #0a0a0a;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease, opacity 0.2s ease;
  }
  .product-grid-flex__quick-add:hover:not(:disabled) {
    background: #333;
  }
  .product-grid-flex__quick-add:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  .product-grid-flex__quick-add--link {
    text-decoration: none;
    text-align: center;
    background: transparent;
    color: #0a0a0a;
    border: 1px solid #0a0a0a;
  }
  .product-grid-flex__quick-add--link:hover {
    background: #0a0a0a;
    color: #fff;
  }
  .product-grid-flex__secondary {
    font-size: 0.75rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    color: hsl(var(--foreground) / 0.65);
    padding: 0.35rem;
  }
  .product-grid-flex__secondary:hover {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .product-grid-flex__soldout {
    font-size: 0.8125rem;
    font-weight: 600;
    color: hsl(var(--foreground) / 0.45);
  }
  .product-grid-flex__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 2rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: #fff;
    background: #0a0a0a;
    border: 1px solid #0a0a0a;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .product-grid-flex__view-all:hover {
    background: #fff;
    color: #0a0a0a;
  }
  .product-grid-flex__empty {
    color: hsl(var(--foreground) / 0.55);
    padding: 2rem;
  }
  .gradient .product-grid-flex__card {
    background: hsl(var(--card));
  }
</style>

{% schema %}
{
  "name": "Product grid (flex)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New releases" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Fresh drops — limited runs." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "horizontal", "label": "Horizontal scroll" }
      ],
      "default": "grid"
    },
    { "type": "checkbox", "id": "enable_quick_add", "label": "Show Quick add", "default": true },
    { "type": "text", "id": "quick_add_label", "label": "Quick add button text", "default": "Quick add" },
    { "type": "text", "id": "quick_add_done_label", "label": "After add text", "default": "Added" },
    { "type": "text", "id": "choose_options_label", "label": "Multi-variant button text", "default": "Choose options" },
    { "type": "text", "id": "button_text", "label": "Secondary link text", "default": "View product" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View all link", "default": true },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "View all" }
  ],
  "presets": [
    { "name": "Product grid (flex)" }
  ]
}
{% endschema %}
