{% comment %}
  Hair Products Showcase Section - Displays products from a collection
{% endcomment %}

<section id="bikes" class="py-24 md:py-32 bg-background">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4">
        {{ section.settings.heading | default: "ENHANCE YOUR LOOK" }}
      </h2>
      <p class="text-lg text-foreground/60 max-w-xl mx-auto">
        {{ section.settings.description | default: "Unmatched Hair. Unstoppable Confidence." }}
      </p>
    </div>

    {%- assign collection = nil -%}
    {%- if section.settings.collection != blank -%}
      {%- assign collection = collections[section.settings.collection] -%}
    {%- endif -%}
    {%- if collection == nil and collections['frontpage'] != blank -%}
      {%- assign collection = collections['frontpage'] -%}
    {%- endif -%}
    {%- if collection != blank and collection.products.size > 0 -%}
        {% render 'amazon-disclosure' %}
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 product-grid product-grid--ads">
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            {%- assign product_index = forloop.index0 -%}
            {%- assign link_block = nil -%}
            {%- assign amazon_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'amazon_link' -%}
                {%- if amazon_count == product_index -%}
                  {%- assign link_block = block -%}
                  {%- break -%}
                {%- endif -%}
                {%- assign amazon_count = amazon_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
            {%- assign view_url = product.url -%}
            {%- if link_block != nil and link_block.settings.url != blank -%}
              {%- assign view_url = link_block.settings.url -%}
            {%- else -%}
              {%- assign title_lower = product.title | downcase -%}
              {%- if title_lower contains "athletic fit tee" or title_lower contains "athletic fit tees" -%}
                {%- assign view_url = "https://amzn.to/45I1l6l" -%}
              {%- elsif title_lower contains "coofandy" and title_lower contains "short" and title_lower contains "button" -%}
                {%- assign view_url = "https://amzn.to/4komatB" -%}
              {%- elsif title_lower contains "soly hux" and title_lower contains "textured" -%}
                {%- assign view_url = "https://amzn.to/47fRl4T" -%}
              {%- elsif title_lower contains "jbl tune flex" -%}
                {%- assign view_url = "https://amzn.to/4rRscFy" -%}
              {%- endif -%}
            {%- endif -%}
            {%- comment -%} Each product slot uses the block at the same position; clicking the card opens that block's link settings. {%- endcomment -%}
            <div class="product-card product-card--ad group relative bg-card rounded-3xl overflow-hidden border-2 border-border/50 hover:border-accent/40"{% if link_block %} {{ link_block.shopify_attributes }}{% endif %}>
              <span class="product-card__ad-badge" aria-hidden="true">{{ 'general.amazon.sponsored' | t | default: 'Sponsored' }}</span>
              <div class="aspect-[4/5] relative overflow-hidden">
                {%- if product.featured_image != blank -%}
                  {%- comment -%} Special handling for styling tool - use object-contain {%- endcomment -%}
                  {%- if product.title contains 'Styling Tool' or product.title contains 'MESCOMB' -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="w-full h-full object-contain transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                    >
                  {%- else -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                    >
                  {%- endif -%}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
                {%- endif -%}
              </div>
              <div class="absolute bottom-0 left-0 right-0 product-card-overlay-inner">
                <div class="absolute inset-0 bg-background/30 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="relative z-10">
                  {%- comment -%} Use vendor as tagline {%- endcomment -%}
                  {%- if product.vendor != blank -%}
                    <p class="product-card-tagline font-medium text-accent uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                      {{ product.vendor }}
                    </p>
                  {%- elsif product.metafields.custom.tagline != blank -%}
                    <p class="product-card-tagline font-medium text-accent uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                      {{ product.metafields.custom.tagline }}
                    </p>
                  {%- endif -%}
                  <h3 class="product-card-title font-bold text-foreground opacity-0 group-hover:opacity-100 transition-opacity duration-300" title="{{ product.title | escape }}">
                    {{ product.title }}
                  </h3>
                  {%- if product.description != blank -%}
                    <p class="product-card-desc text-foreground/60 max-w-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300 line-clamp-2">
                      {{ product.description | strip_html | truncate: 100 }}
                    </p>
                  {%- endif -%}
                  <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <a href="{{ view_url }}" class="btn-hero text-xs" target="_blank" rel="noopener noreferrer{% if view_url contains 'amzn.to' %} sponsored{% endif %}">{% if view_url contains 'amzn.to' %}{% if section.settings.button_text_amazon != blank %}{{ section.settings.button_text_amazon }}{% else %}{{ 'general.amazon.view_on_amazon' | t | default: 'View on Amazon' }}{% endif %}{% else %}{% if section.settings.button_text_product != blank %}{{ section.settings.button_text_product }}{% else %}{{ 'general.amazon.view_product' | t | default: 'View product' }}{% endif %}{% endif %}</a>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
    {%- else -%}
      <p class="text-center text-foreground/60">No products to show. In the sidebar under "Products in grid", select a Collection that has products.</p>
    {%- endif -%}
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

{% schema %}
{
  "name": "Hair Products Showcase",
  "settings": [
    {
      "type": "header",
      "content": "Product links"
    },
    {
      "type": "paragraph",
      "content": "Each product can have its own link. Add one 'Product link' block per product: choose the product and enter the Link URL. Click a product card in the preview to open that product's link settings (add a block for it first if needed)."
    },
    {
      "type": "header",
      "content": "Products in grid"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Choose the collection. Products from this collection appear in the grid above. Defaults to Homepage collection if empty."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ENHANCE YOUR LOOK"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Unmatched Hair. Unstoppable Confidence."
    },
    {
      "type": "header",
      "content": "Button labels"
    },
    {
      "type": "text",
      "id": "button_text_amazon",
      "label": "View on Amazon button text",
      "default": "View on Amazon",
      "info": "Shown when the product link goes to Amazon."
    },
    {
      "type": "text",
      "id": "button_text_product",
      "label": "View product button text",
      "default": "View product",
      "info": "Shown when the product uses a non-Amazon link."
    },
  ],
  "blocks": [
    {
      "type": "amazon_link",
      "name": "Product link",
      "limit": 50,
      "settings": [
        {
          "type": "header",
          "content": "Product and link"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Select the product. This block's link will be used for its button."
        },
        {
          "type": "text",
          "id": "url",
          "label": "Link URL",
          "placeholder": "https://amzn.to/xxxxx or any URL",
          "info": "Paste the full URL for the View product button."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hair Products Showcase",
      "blocks": [
        { "type": "amazon_link", "settings": {} },
        { "type": "amazon_link", "settings": {} },
        { "type": "amazon_link", "settings": {} },
        { "type": "amazon_link", "settings": {} },
        { "type": "amazon_link", "settings": {} },
        { "type": "amazon_link", "settings": {} },
        { "type": "amazon_link", "settings": {} },
        { "type": "amazon_link", "settings": {} },
        { "type": "amazon_link", "settings": {} },
        { "type": "amazon_link", "settings": {} },
        { "type": "amazon_link", "settings": {} },
        { "type": "amazon_link", "settings": {} }
      ]
    }
  ]
}
{% endschema %}
