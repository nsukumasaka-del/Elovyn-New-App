{% comment %}
  CRO: Reusable "why shop with us" strip — icon + short text blocks, editable in Theme Customizer.
{% endcomment %}
<section class="home-benefits section-spacing" id="shopify-section-{{ section.id }}">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="home-benefits__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="home-benefits__sub">{{ section.settings.subheading }}</p>
    {% endif %}
    <ul class="home-benefits__grid" role="list">
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <li class="home-benefits__item" {{ block.shopify_attributes }}>
            <span class="home-benefits__icon" aria-hidden="true">{{ block.settings.icon | default: '✓' }}</span>
            <div class="home-benefits__text">
              {% if block.settings.title != blank %}
                <strong class="home-benefits__title">{{ block.settings.title }}</strong>
              {% endif %}
              {% if block.settings.text != blank %}
                <span class="home-benefits__desc">{{ block.settings.text }}</span>
              {% endif %}
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

<style>
  /* CRO: clean grid, thumb-friendly tap targets on mobile */
  .home-benefits { background: {{ section.settings.background_color | default: '#f5f5f5' }}; }
  .home-benefits__heading {
    margin: 0 0 0.35rem;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
    color: #0a0a0a;
  }
  .home-benefits__sub {
    margin: 0 auto 1.5rem;
    max-width: 36rem;
    text-align: center;
    color: rgba(0, 0, 0, 0.6);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .home-benefits__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .home-benefits__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    /* CRO: fluid columns — works with 3–5 blocks without hard-coding count */
    .home-benefits__grid { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  }
  .home-benefits__item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-height: 48px;
    padding: 1rem 1.1rem;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 0;
  }
  .home-benefits__icon {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    background: #0a0a0a;
    color: #fff;
    border-radius: 50%;
  }
  .home-benefits__text { display: flex; flex-direction: column; gap: 0.2rem; }
  .home-benefits__title { font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .home-benefits__desc { font-size: 0.875rem; color: rgba(0, 0, 0, 0.65); line-height: 1.45; }
</style>

{% schema %}
{
  "name": "Home benefits",
  "tag": "section",
  "class": "section-home-benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why shop with us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Fast shipping, easy returns, and secure checkout on every order."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#f5f5f5"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji or symbol)", "default": "✓" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Description", "default": "On qualifying orders — see checkout for details." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Home benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "🚚", "title": "Fast dispatch", "text": "Orders ship within 1–3 business days." } },
        { "type": "benefit", "settings": { "icon": "↩", "title": "Easy returns", "text": "Hassle-free returns within 14 days." } },
        { "type": "benefit", "settings": { "icon": "🔒", "title": "Secure checkout", "text": "Encrypted payments you can trust." } },
        { "type": "benefit", "settings": { "icon": "★", "title": "Quality first", "text": "Curated pieces built for everyday wear." } }
      ]
    }
  ]
}
{% endschema %}
