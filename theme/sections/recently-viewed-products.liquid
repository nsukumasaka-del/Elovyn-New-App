<section class="recently-viewed section-spacing" data-recently-viewed>
  <div class="container">
    <h2 class="recently-viewed__title">{{ section.settings.heading | default: "Recently viewed" }}</h2>
    <div class="recently-viewed__grid" data-recently-grid></div>
  </div>
</section>
<script>
  (function(){
    var root = document.querySelector('[data-recently-viewed]');
    if(!root) return;
    var grid = root.querySelector('[data-recently-grid]');
    if(!grid) return;
    var key = 'elovyn_recently_viewed';
    var current = {{ product.handle | default: '' | json }};
    var handles = [];
    try { handles = JSON.parse(localStorage.getItem(key) || '[]'); } catch(e) {}
    handles = handles.filter(function(h){ return h && h !== current; }).slice(0, {{ section.settings.products_to_show | default: 4 }});
    if(!handles.length){ root.style.display='none'; return; }
    Promise.all(handles.map(function(handle){
      return fetch('/products/' + encodeURIComponent(handle) + '.js', { credentials:'same-origin' }).then(function(r){ return r.ok ? r.json() : null; }).catch(function(){ return null; });
    })).then(function(items){
      var html = items.filter(Boolean).map(function(p){
        var img = p.images && p.images[0] ? p.images[0] : '';
        var price = (p.price || 0) / 100;
        return '<article class="recently-viewed__card"><a href=\"/products/' + p.handle + '\" class=\"recently-viewed__image\">' + (img ? '<img src=\"' + img + '&width=700\" alt=\"' + (p.title || '').replace(/\"/g,'&quot;') + '\" loading=\"lazy\">' : '') + '</a><a href=\"/products/' + p.handle + '\" class=\"recently-viewed__name\">' + (p.title || '') + '</a><span class=\"recently-viewed__price\">' + (window.Shopify && Shopify.formatMoney ? Shopify.formatMoney(p.price, window.theme && theme.moneyFormat ? theme.moneyFormat : undefined) : '$' + price.toFixed(2)) + '</span></article>';
      }).join('');
      grid.innerHTML = html;
      if(!html) root.style.display='none';
    });
  })();
</script>
<style>
  .recently-viewed__title{margin:0 0 .9rem;text-transform:uppercase;font-size:clamp(1.1rem,2.5vw,1.6rem)}
  .recently-viewed__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  @media(min-width:980px){.recently-viewed__grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
  .recently-viewed__image{display:block;aspect-ratio:4/5;overflow:hidden}
  .recently-viewed__image img{width:100%;height:100%;object-fit:cover;display:block}
  .recently-viewed__name{display:block;margin:.55rem 0 .2rem;color:#000;text-decoration:none}
  .recently-viewed__name:hover{text-decoration:underline}
  .recently-viewed__price{font-weight:700}
</style>
{% schema %}
{
  "name": "Recently viewed products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Recently viewed products" }]
}
{% endschema %}
