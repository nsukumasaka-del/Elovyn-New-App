<script>
(function() {
  var root = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!root) return;

  var form = document.getElementById('CollectionFiltersForm');
  var sort = document.getElementById('ColSortBy');
  if (sort && form) {
    sort.addEventListener('change', function() { form.submit(); });
  }

  var drawer = document.getElementById('ColFilterDrawer');
  var overlay = document.getElementById('ColFilterOverlay');
  var openBtn = document.getElementById('ColFilterDrawerOpen');
  function isMobileFilters() {
    return window.matchMedia('(max-width: 1023px)').matches;
  }
  function openDrawer() {
    if (!drawer || !overlay || !isMobileFilters()) return;
    drawer.classList.add('col-plp-sidebar--open');
    overlay.removeAttribute('hidden');
    if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    if (!drawer || !overlay) return;
    drawer.classList.remove('col-plp-sidebar--open');
    overlay.setAttribute('hidden', '');
    if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  if (openBtn) openBtn.addEventListener('click', openDrawer);
  overlay && overlay.addEventListener('click', closeDrawer);
  drawer && drawer.querySelectorAll('[data-drawer-close]').forEach(function(el) {
    el.addEventListener('click', closeDrawer);
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && drawer && drawer.classList.contains('col-plp-sidebar--open')) closeDrawer();
  });
  window.addEventListener('resize', function() {
    if (!isMobileFilters()) closeDrawer();
  });

  root.querySelectorAll('[data-filter-accordion]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var ex = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', ex ? 'false' : 'true');
    });
  });

  var cartAddBase = (window.routes && window.routes.cart_add_url) || '/cart/add';
  var addUrl = cartAddBase.replace(/\/add\/?(\?.*)?$/i, '') + '/add.js';

  root.querySelectorAll('.col-plp-card').forEach(function(card) {
    var toggle = card.querySelector('[data-quick-add-toggle]');
    var panel = card.querySelector('[data-quick-add-panel]');
    var msg = card.querySelector('[data-quick-msg]');
    if (toggle && panel) {
      toggle.addEventListener('click', function(e) {
        e.preventDefault();
        var open = !panel.hidden;
        panel.hidden = open;
        toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
      });
    }
    card.querySelectorAll('[data-variant-id]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var id = btn.getAttribute('data-variant-id');
        if (!id || btn.disabled) return;
        btn.disabled = true;
        if (msg) msg.textContent = '…';
        var fd = new FormData();
        fd.append('id', id);
        fd.append('quantity', '1');
        fetch(addUrl, { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
          .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, d: d }; }); })
          .then(function(res) {
            if (res.ok && typeof window.updateCartCount === 'function') window.updateCartCount();
            if (msg) msg.textContent = res.ok ? 'Added to cart' : (res.d && res.d.description ? String(res.d.description) : 'Could not add');
            if (res.ok) setTimeout(function() { if (msg) msg.textContent = ''; }, 2000);
          })
          .catch(function() { if (msg) msg.textContent = 'Error'; })
          .finally(function() { btn.disabled = false; });
      });
    });
  });
})();
</script>

