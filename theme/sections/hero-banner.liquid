{%- assign overlay_opacity = section.settings.overlay_opacity | default: 45 | times: 1.0 | divided_by: 100.0 -%}
{%- assign hero_text_color = section.settings.text_color | default: '#ffffff' -%}
{%- assign hero_button_text_color = section.settings.button_text_color | default: '#ffffff' -%}
<section class="elite-hero-banner" data-section-id="{{ section.id }}">
  <picture class="elite-hero-banner__picture">
    {%- if section.settings.mobile_image != blank -%}
      <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">
    {%- endif -%}
    {%- if section.settings.desktop_image != blank -%}
      <img
        src="{{ section.settings.desktop_image | image_url: width: 2200 }}"
        srcset="{{ section.settings.desktop_image | image_url: width: 900 }} 900w, {{ section.settings.desktop_image | image_url: width: 1440 }} 1440w, {{ section.settings.desktop_image | image_url: width: 2200 }} 2200w"
        sizes="100vw"
        alt="{{ section.settings.heading | escape }}"
        width="{{ section.settings.desktop_image.width }}"
        height="{{ section.settings.desktop_image.height }}"
        fetchpriority="high"
      >
    {%- elsif section.settings.fallback_image_url != blank -%}
      <img src="{{ section.settings.fallback_image_url }}" alt="{{ section.settings.heading | escape }}" width="2200" height="1200">
    {%- else -%}
      <img src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=2200&q=80" alt="{{ section.settings.heading | escape }}" width="2200" height="1200">
    {%- endif -%}
  </picture>
  <div class="elite-hero-banner__overlay" style="opacity: {{ overlay_opacity }};"></div>
  <div class="elite-hero-banner__content container" style="color: {{ hero_text_color }};">
    <h1>{{ section.settings.heading | default: "Built different." }}</h1>
    <p>{{ section.settings.subheading | default: "Premium essentials engineered for daily confidence." }}</p>
    <a class="elite-hero-banner__cta" href="{{ section.settings.button_link | default: '/collections/all' }}" style="color: {{ hero_button_text_color }};">{{ section.settings.button_label | default: "Shop now" }}</a>
  </div>
</section>

<style>
  .elite-hero-banner{position:relative;min-height:78vh;display:flex;align-items:center;overflow:hidden}
  .elite-hero-banner__picture,.elite-hero-banner__picture img{position:absolute;inset:0;width:100%;height:100%}
  .elite-hero-banner__picture img{object-fit:cover;display:block}
  .elite-hero-banner__overlay{position:absolute;inset:0;background:#000}
  .elite-hero-banner__content{position:relative;z-index:2;padding:2rem 1.5rem}
  .elite-hero-banner__content h1{margin:0 0 .55rem;font-size:clamp(2rem,6vw,4.8rem);line-height:.95;text-transform:uppercase}
  .elite-hero-banner__content p{margin:0 0 1rem;max-width:36rem;color:inherit;opacity:.92}
  .elite-hero-banner__cta{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 1.25rem;background:#000;text-decoration:none;font-weight:700;text-transform:uppercase;font-size:.78rem;letter-spacing:.08em;border:1px solid #fff}
  .elite-hero-banner__cta:hover{opacity:.9}
</style>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
    { "type": "text", "id": "fallback_image_url", "label": "Fallback image URL", "default": "https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=2200&q=80" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay darkness", "min": 20, "max": 80, "step": 5, "unit": "%", "default": 45 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#ffffff" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built different." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Premium essentials engineered for daily confidence." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
