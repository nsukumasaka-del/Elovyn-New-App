<section class="elite-newsletter section-spacing">
  <div class="container">
    <div class="elite-newsletter__box">
      <h2>{{ section.settings.heading | default: "Join our newsletter" }}</h2>
      <p>{{ section.settings.subheading | default: "Get exclusive updates and offers tailored to your interests." }}</p>
      {% form 'customer', class: 'elite-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}" required>
        <button type="submit">{{ section.settings.button_text | default: "Subscribe" }}</button>
      {% endform %}
    </div>
  </div>
</section>
<style>
  .elite-newsletter__box{max-width:760px;margin:0 auto;text-align:center;padding:2rem 1.25rem;border:1px solid rgba(0,0,0,.14);background:#fff}
  .elite-newsletter__box h2{margin:0 0 .45rem;text-transform:uppercase;font-size:clamp(1.2rem,3vw,2rem)}
  .elite-newsletter__box p{margin:0 0 1rem;color:rgba(0,0,0,.65)}
  .elite-newsletter__form{display:flex;flex-direction:column;gap:.6rem;max-width:520px;margin:0 auto}
  @media(min-width:640px){.elite-newsletter__form{flex-direction:row}}
  .elite-newsletter__form input{flex:1;min-height:46px;padding:0 .75rem;border:1px solid rgba(0,0,0,.2)}
  .elite-newsletter__form button{min-height:46px;padding:0 1rem;border:1px solid #000;background:#000;color:#fff;font-weight:700;text-transform:uppercase;font-size:.74rem;letter-spacing:.06em;cursor:pointer}
  .elite-newsletter__form button:hover{opacity:.9}
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join our newsletter" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Get exclusive updates and offers tailored to your interests." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
