{%- assign featured_collection = collections[section.settings.collection] -%}
<section class="elite-featured-products section-spacing" data-section-id="{{ section.id }}">
  <div class="container">
    <header class="elite-featured-products__head">
      <h2>{{ section.settings.heading | default: "Best sellers" }}</h2>
      <p>{{ section.settings.subheading | default: "Top picks selected for your audience." }}</p>
    </header>
    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <div class="elite-featured-products__grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          <article class="elite-featured-products__card">
            <a href="{{ product.url }}" class="elite-featured-products__image">
              {% if product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
              {% endif %}
            </a>
            <div class="elite-featured-products__body">
              <a href="{{ product.url }}" class="elite-featured-products__title">{{ product.title }}</a>
              <span class="elite-featured-products__price">{{ product.price | money }}</span>
              {% if section.settings.enable_quick_add and product.available %}
                {% if product.has_only_default_variant %}
                  <button type="button" class="elite-featured-products__quick" data-quick-id="{{ product.selected_or_first_available_variant.id }}">{{ section.settings.quick_add_text | default: "Quick add" }}</button>
                {% else %}
                  <a href="{{ product.url }}" class="elite-featured-products__quick elite-featured-products__quick--link">{{ section.settings.choose_options_text | default: "Choose options" }}</a>
                {% endif %}
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="elite-featured-products__empty">Select a collection with products.</p>
    {% endif %}
  </div>
</section>
<script>
  (function(){
    var root = document.querySelector('.elite-featured-products[data-section-id="{{ section.id }}"]');
    if(!root) return;
    var addUrl = ((window.routes && window.routes.cart_add_url) || '/cart/add').replace(/\/add\/?(\?.*)?$/i, '') + '/add.js';
    root.querySelectorAll('[data-quick-id]').forEach(function(btn){
      btn.addEventListener('click', function(){
        if(btn.disabled) return;
        var id = btn.getAttribute('data-quick-id');
        if(!id) return;
        btn.disabled = true;
        var prev = btn.textContent;
        btn.textContent = '{{ section.settings.added_text | default: "Added" }}';
        var fd = new FormData();
        fd.append('id', id);
        fd.append('quantity', '1');
        fetch(addUrl, { method:'POST', body:fd, credentials:'same-origin', headers:{'Accept':'application/json'} })
          .then(function(){ if (typeof window.updateCartCount === 'function') window.updateCartCount(); })
          .catch(function(){})
          .finally(function(){ setTimeout(function(){btn.textContent = prev; btn.disabled = false;}, 1300); });
      });
    });
  })();
</script>
<style>
  .elite-featured-products__head{text-align:center;margin:0 0 1.2rem}
  .elite-featured-products__head h2{margin:0 0 .35rem;text-transform:uppercase;font-size:clamp(1.45rem,3.5vw,2.3rem)}
  .elite-featured-products__head p{margin:0 auto;max-width:34rem;color:rgba(0,0,0,.65)}
  .elite-featured-products__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  @media(min-width:980px){.elite-featured-products__grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:1.2rem}}
  .elite-featured-products__image{display:block;aspect-ratio:4/5;overflow:hidden}
  .elite-featured-products__image img{width:100%;height:100%;object-fit:cover;display:block}
  .elite-featured-products__body{padding:.6rem 0}
  .elite-featured-products__title{display:block;color:#000;text-decoration:none}
  .elite-featured-products__title:hover{text-decoration:underline}
  .elite-featured-products__price{display:block;font-weight:700;margin:.2rem 0 .55rem}
  .elite-featured-products__quick{display:inline-flex;align-items:center;justify-content:center;width:100%;min-height:42px;background:#000;color:#fff;border:1px solid #000;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;cursor:pointer;text-decoration:none}
  .elite-featured-products__quick:hover{opacity:.9}
  .elite-featured-products__quick--link{background:#fff;color:#000}
</style>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Top picks selected for your audience." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "enable_quick_add", "label": "Enable quick add", "default": true },
    { "type": "text", "id": "quick_add_text", "label": "Quick add text", "default": "Quick add" },
    { "type": "text", "id": "choose_options_text", "label": "Choose options text", "default": "Choose options" },
    { "type": "text", "id": "added_text", "label": "Added text", "default": "Added" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
