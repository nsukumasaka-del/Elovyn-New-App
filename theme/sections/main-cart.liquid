{% comment %}
  Cart page – modern style. Responsive for all screen sizes and resolutions.
{% endcomment %}

<section class="main-cart-page min-h-[60vh]" aria-label="Shopping cart">
  <div class="main-cart-inner main-cart-container">
    <header class="main-cart-header-bar">
      <h1 class="main-cart-title">
        {{ 'sections.cart.title' | t }}
      </h1>
      {% if cart.item_count > 0 %}
        <p class="main-cart-count">
          {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}
        </p>
      {% endif %}
    </header>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="main-cart-form" data-auto-update-cart>
        <input type="hidden" name="update" value="Update">
        <div class="main-cart-grid">
          <div class="main-cart-items-col">
            <ul class="main-cart-items space-y-0 divide-y main-cart-divider">
              {% for item in cart.items %}
                <li class="main-cart-item">
                  <a href="{{ item.url }}" class="main-cart-item-image" aria-hidden="true">
                    {% if item.image != blank %}
                      <img src="{{ item.image | image_url: width: 192 }}" alt="{{ item.image.alt | escape }}" class="main-cart-item-img" loading="lazy" width="96" height="96">
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'main-cart-item-img main-cart-item-placeholder' }}
                    {% endif %}
                  </a>
                  <div class="main-cart-item-details">
                    <div class="main-cart-item-info">
                      <a href="{{ item.url }}" class="main-cart-item-title">{{ item.product.title }}</a>
                      {% unless item.product.has_only_default_variant %}
                        <p class="main-cart-variant">{{ item.variant.title }}</p>
                      {% endunless %}
                      <p class="main-cart-price">{{ item.final_line_price | money }}</p>
                    </div>
                    <div class="main-cart-item-actions">
                      <label for="updates_{{ item.key }}" class="visually-hidden">Quantity for {{ item.product.title }}</label>
                      <div class="main-cart-qty">
                        <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" max="99" class="main-cart-qty-input" aria-label="Quantity">
                      </div>
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="main-cart-remove">
                        {{ 'sections.cart.remove' | t }}
                      </a>
                    </div>
                  </div>
                </li>
              {% endfor %}
            </ul>
          </div>

          <div class="main-cart-summary-col">
            <div class="main-cart-summary">
              <div class="main-cart-summary-row">
                <span class="main-cart-label">{{ 'sections.cart.subtotal' | t }}</span>
                <span class="main-cart-total">{{ cart.total_price | money }}</span>
              </div>
              <p class="main-cart-note">Shipping and taxes calculated at checkout.</p>
              <div class="main-cart-trust-list" aria-label="Secure checkout and payments">
                <span class="main-cart-trust-item">Secure checkout</span>
                <span class="main-cart-trust-item">PayFast</span>
                <span class="main-cart-trust-item">PayPal</span>
                <span class="main-cart-trust-item">Stripe</span>
              </div>
              <div class="main-cart-buttons">
                <button type="submit" name="checkout" class="main-cart-checkout-btn">
                  {{ 'sections.cart.checkout' | t }}
                </button>
                <a href="{{ routes.root_url }}" class="main-cart-continue">{{ 'sections.cart.continue_shopping' | t }}</a>
                <button type="button" class="main-cart-clear-btn" data-clear-cart data-confirm="{{ 'sections.cart.clear_cart_confirm' | t | escape }}" aria-label="{{ 'sections.cart.clear_cart' | t }}">
                  {{ 'sections.cart.clear_cart' | t }}
                </button>
              </div>
            </div>
          </div>
        </div>
      </form>
    {% else %}
      <div class="main-cart-empty">
        <div class="main-cart-empty-icon" aria-hidden="true">
          <svg class="main-cart-empty-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
        </div>
        <h2 class="main-cart-empty-title">{{ 'sections.cart.empty' | t }}</h2>
        <p class="main-cart-empty-text">Add items from the homepage or any collection to get started.</p>
        <a href="{{ routes.root_url }}" class="main-cart-checkout-btn main-cart-empty-cta">{{ 'sections.cart.continue_shopping' | t }}</a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  /* Base: prevent overflow, safe areas, explicit text color for visibility */
  .main-cart-page {
    background: #ffffff;
    color: #111111;
    padding-top: 5rem;
    padding-bottom: 2rem;
    overflow-x: hidden;
    padding-left: env(safe-area-inset-left, 0);
    padding-right: env(safe-area-inset-right, 0);
    box-sizing: border-box;
  }
  .main-cart-page * {
    box-sizing: border-box;
  }
  @media (min-width: 375px) {
    .main-cart-page { padding-top: 5.5rem; padding-bottom: 2.5rem; }
  }
  @media (min-width: 768px) {
    .main-cart-page { padding-top: 7rem; padding-bottom: 4rem; }
  }
  @media (min-width: 1024px) {
    .main-cart-page { padding-bottom: 5rem; }
  }

  /* Container: responsive padding and max-width */
  .main-cart-container {
    width: 100%;
    max-width: 72rem;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1rem;
    padding-right: 1rem;
    box-sizing: border-box;
  }
  @media (min-width: 375px) {
    .main-cart-container { padding-left: 1.25rem; padding-right: 1.25rem; }
  }
  @media (min-width: 640px) {
    .main-cart-container { padding-left: 1.5rem; padding-right: 1.5rem; }
  }
  @media (min-width: 1024px) {
    .main-cart-container { padding-left: 2rem; padding-right: 2rem; }
  }

  /* Header bar: full-bleed black bar, no overlap, always visible text */
  .main-cart-header-bar {
    background: #000000;
    color: #ffffff;
    margin-left: -1rem;
    margin-right: -1rem;
    padding: 1rem;
    padding-left: calc(1rem + env(safe-area-inset-left, 0));
    padding-right: calc(1rem + env(safe-area-inset-right, 0));
    border-radius: 0;
    box-sizing: border-box;
    margin-bottom: 1.25rem;
    min-height: 3.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  @media (min-width: 375px) {
    .main-cart-header-bar { margin-left: -1.25rem; margin-right: -1.25rem; padding: 1.25rem; padding-left: calc(1.25rem + env(safe-area-inset-left, 0)); padding-right: calc(1.25rem + env(safe-area-inset-right, 0)); margin-bottom: 1.5rem; min-height: 4rem; }
  }
  @media (min-width: 640px) {
    .main-cart-header-bar { margin-left: -1.5rem; margin-right: -1.5rem; padding: 1.25rem 1.5rem; padding-left: calc(1.5rem + env(safe-area-inset-left, 0)); padding-right: calc(1.5rem + env(safe-area-inset-right, 0)); }
  }
  @media (min-width: 768px) {
    .main-cart-header-bar { margin-bottom: 2rem; }
  }
  .main-cart-header-bar .main-cart-title {
    font-size: clamp(1.25rem, 4.5vw, 1.875rem);
    font-weight: 700;
    color: #ffffff !important;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.25;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
  .main-cart-header-bar .main-cart-count {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.9) !important;
  }
  .main-cart-title { font-size: 1.5rem; font-weight: 700; color: #111111; letter-spacing: -0.02em; }
  .main-cart-count { margin-top: 0.25rem; font-size: 0.875rem; color: rgba(0,0,0,0.6); }

  /* Grid: single column on small, two columns on large */
  .main-cart-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .main-cart-grid { gap: 2rem; }
  }
  @media (min-width: 1024px) {
    .main-cart-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      max-width: 72rem;
    }
  }
  @media (min-width: 1280px) {
    .main-cart-grid {
      grid-template-columns: 3fr 2fr;
      gap: 2.5rem;
    }
  }

  /* Cart items list – no overlap, clear alignment on mobile */
  .main-cart-divider { border-color: rgba(0,0,0,0.08); }
  .main-cart-border { border-color: rgba(0,0,0,0.12); }
  .main-cart-item {
    display: flex;
    gap: 0.875rem;
    padding: 1.125rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    align-items: flex-start;
  }
  .main-cart-item:first-child { padding-top: 0; }
  @media (min-width: 375px) {
    .main-cart-item { gap: 1rem; padding: 1.25rem 0; }
  }
  @media (min-width: 1024px) {
    .main-cart-item { padding: 1.25rem 0; gap: 1.25rem; }
  }
  .main-cart-item-image {
    flex-shrink: 0;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.12);
    background: #fff;
    display: block;
    transition: border-color 0.2s;
  }
  .main-cart-item-image:hover { border-color: rgba(0,0,0,0.3); }
  @media (min-width: 375px) {
    .main-cart-item-image { width: 5rem; height: 5rem; }
  }
  @media (min-width: 640px) {
    .main-cart-item-image { width: 5.5rem; height: 5.5rem; }
  }
  .main-cart-item-img,
  .main-cart-item-image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .main-cart-item-details {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    align-items: stretch;
  }
  @media (min-width: 480px) {
    .main-cart-item-details {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
  }
  .main-cart-item-info {
    min-width: 0;
    overflow: hidden;
  }
  /* Title: wrap 2 lines on all sizes, ellipsis after 2 lines – prevents overlap */
  .main-cart-item-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-weight: 600;
    color: #111111 !important;
    font-size: 0.875rem;
    line-height: 1.35;
    text-decoration: none;
    transition: opacity 0.2s;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
  .main-cart-item-title:hover { opacity: 0.7; }
  @media (min-width: 640px) {
    .main-cart-item-title { font-size: 1rem; }
  }
  .main-cart-variant {
    font-size: 0.75rem;
    color: rgba(0,0,0,0.65) !important;
    margin: 0.25rem 0 0 0;
  }
  .main-cart-price {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111111 !important;
    margin: 0.25rem 0 0 0;
  }
  @media (min-width: 480px) {
    .main-cart-price { margin-top: 0.375rem; }
  }
  .main-cart-item-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  @media (min-width: 480px) {
    .main-cart-item-actions { gap: 1rem; margin-top: 0; }
  }
  .main-cart-qty {
    display: flex;
    align-items: center;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 0.5rem;
    overflow: hidden;
    background: #fff;
  }
  .main-cart-qty-input {
    width: 2.75rem;
    min-width: 2.75rem;
    padding: 0.5rem 0;
    text-align: center;
    font-size: 0.875rem;
    color: #111111 !important;
    background: transparent;
    border: none;
    border-left: 1px solid rgba(0,0,0,0.12);
    border-right: 1px solid rgba(0,0,0,0.12);
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .main-cart-qty-input::-webkit-inner-spin-button,
  .main-cart-qty-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
    opacity: 1;
  }
  @media (min-width: 375px) {
    .main-cart-qty-input { width: 3rem; min-width: 3rem; min-height: 44px; }
  }
  .main-cart-remove {
    font-size: 0.8125rem;
    color: rgba(0,0,0,0.6) !important;
    white-space: nowrap;
    text-decoration: none;
    padding: 0.5rem 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s;
  }
  .main-cart-remove:hover { opacity: 0.7; }

  /* Summary sidebar / block */
  .main-cart-summary-col {
    order: -1;
  }
  @media (min-width: 1024px) {
    .main-cart-summary-col { order: unset; }
  }
  .main-cart-summary {
    background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    position: sticky;
    top: 5rem;
    box-sizing: border-box;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    transition: box-shadow 0.2s ease;
  }
  .main-cart-summary:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
  }
  @media (min-width: 375px) {
    .main-cart-summary { padding: 1.25rem 1.5rem; top: 5.5rem; }
  }
  @media (min-width: 768px) {
    .main-cart-summary { padding: 1.5rem; top: 6rem; }
  }
  @media (min-width: 1024px) {
    .main-cart-summary { padding: 1.5rem 1.75rem; top: 6.25rem; }
  }
  /* Summary row: no overlap on small screens */
  .main-cart-summary-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
    flex-wrap: nowrap;
  }
  .main-cart-label {
    font-size: 0.875rem;
    color: rgba(0,0,0,0.7) !important;
    flex-shrink: 0;
  }
  .main-cart-total {
    font-size: clamp(1.125rem, 3vw, 1.5rem);
    font-weight: 700;
    color: #111111 !important;
    min-width: 0;
    text-align: right;
    overflow-wrap: break-word;
    word-wrap: break-word;
  }
  .main-cart-note {
    font-size: 0.8125rem;
    color: rgba(0,0,0,0.55) !important;
    margin: 0 0 1rem 0;
    line-height: 1.4;
  }
  .main-cart-trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1rem 0;
  }
  .main-cart-trust-item {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(0,0,0,0.12);
    background: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    color: #111;
  }
  @media (min-width: 375px) {
    .main-cart-note { margin-bottom: 1.25rem; }
  }
  .main-cart-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .main-cart-checkout-btn {
    display: block;
    width: 100%;
    min-height: 48px;
    padding: 0.875rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #ffffff !important;
    background: #111111;
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    box-sizing: border-box;
    transition: opacity 0.2s;
    -webkit-tap-highlight-color: transparent;
    line-height: 1.3;
    word-wrap: break-word;
  }
  .main-cart-checkout-btn:hover { opacity: 0.92; }
  .main-cart-continue {
    display: block;
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #111111 !important;
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 0.75rem;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    box-sizing: border-box;
    transition: background-color 0.2s, color 0.2s;
    -webkit-tap-highlight-color: transparent;
    line-height: 1.4;
    word-wrap: break-word;
  }
  .main-cart-continue:hover { background: rgba(0,0,0,0.04); }
  .main-cart-clear-btn {
    display: block;
    width: 100%;
    margin-top: 0.25rem;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(0,0,0,0.6);
    background: transparent;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .main-cart-clear-btn:hover {
    background: rgba(0,0,0,0.04);
    color: #111111;
    border-color: rgba(0,0,0,0.2);
  }

  /* Empty state – visible text, proper alignment */
  .main-cart-empty {
    max-width: 22rem;
    margin: 0 auto;
    text-align: center;
    padding: 3rem 0.5rem 4rem;
    box-sizing: border-box;
  }
  @media (min-width: 375px) {
    .main-cart-empty { padding: 4rem 1rem 5rem; }
  }
  .main-cart-empty-icon {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: rgba(0,0,0,0.06);
    border: 1px solid rgba(0,0,0,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }
  .main-cart-empty-svg {
    width: 2rem;
    height: 2rem;
    color: rgba(0,0,0,0.45);
  }
  .main-cart-empty-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #111111 !important;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }
  @media (min-width: 375px) {
    .main-cart-empty-title { font-size: 1.25rem; }
  }
  .main-cart-empty-text {
    font-size: 0.875rem;
    color: rgba(0,0,0,0.65) !important;
    margin: 0 0 1.5rem 0;
    line-height: 1.5;
  }
  .main-cart-empty-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
  }

  /* List container – no overflow */
  .main-cart-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Update cart button never shown – cart updates automatically on quantity change */
  .main-cart-form button[name="update"],
  .main-cart-form .main-cart-update-btn {
    display: none !important;
  }
  .main-cart-form--updating { opacity: 0.7; pointer-events: none; }
  .main-cart-form--updating .main-cart-checkout-btn { cursor: wait; }
</style>

<script>
  (function() {
    var form = document.getElementById('cart-form');
    if (!form) return;
    var inputs = form.querySelectorAll('input[name="updates[]"]');
    function submitCart() {
      form.classList.add('main-cart-form--updating');
      form.submit();
    }
    inputs.forEach(function(input) {
      input.addEventListener('change', submitCart);
    });
    var clearBtn = form.querySelector('[data-clear-cart]');
    if (clearBtn) {
      clearBtn.addEventListener('click', function() {
        if (!confirm(clearBtn.getAttribute('data-confirm') || 'Clear all items from your cart?')) return;
        inputs.forEach(function(input) { input.value = '0'; });
        submitCart();
      });
    }
  })();
</script>
