{% comment %}
  Clean trust messaging section (Superbalist-inspired):
  - Subtle top trust bar
  - Premium text-only trust grid
  - No icons, no cards, no shadows
{% endcomment %}

<section class="trust-clean section-spacing" id="shopify-section-{{ section.id }}">
  {% if section.settings.show_top_bar %}
    <div class="trust-clean__topbar" role="note" aria-label="Trust highlights">
      <div class="trust-clean__container trust-clean__container--narrow">
        <p class="trust-clean__topbar-text">
          {{ section.settings.top_bar_text | default: 'Free shipping over R500 • Easy 14-day returns • Secure checkout' }}
        </p>
      </div>
    </div>
  {% endif %}

  <div class="trust-clean__main">
    <div class="trust-clean__container">
      {% if section.settings.heading != blank %}
        <h2 class="trust-clean__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <p class="trust-clean__subtext">{{ section.settings.subtext }}</p>
      {% endif %}

      <div class="trust-clean__grid" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'trust_column' %}
            <article class="trust-clean__item" role="listitem" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3 class="trust-clean__item-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="trust-clean__item-text">{{ block.settings.text }}</p>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  .trust-clean__container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  .trust-clean__container--narrow {
    max-width: 1400px;
  }

  /* Top trust bar */
  .trust-clean__topbar {
    background: {{ section.settings.top_bar_bg | default: '#f5f5f5' }};
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .trust-clean__topbar-text {
    margin: 0;
    min-height: 2.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: clamp(0.75rem, 1.4vw, 0.875rem);
    color: {{ section.settings.top_bar_text_color | default: '#666666' }};
    letter-spacing: 0.08em;
    line-height: 1.25;
    padding: 0.25rem 0;
  }

  /* Main trust block */
  .trust-clean__main {
    padding-top: clamp(3.75rem, 8vw, 6.25rem);
    padding-bottom: clamp(3.75rem, 8vw, 6.25rem);
    background: {{ section.settings.section_bg | default: '#ffffff' }};
  }
  .trust-clean__heading {
    margin: 0 0 0.7rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.15;
    font-weight: 800;
    color: #111111;
    text-align: left;
  }
  .trust-clean__subtext {
    margin: 0 0 clamp(2rem, 5vw, 3rem);
    max-width: 44rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #6a6a6a;
    text-align: left;
  }

  .trust-clean__grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: clamp(1.5rem, 4vw, 3.25rem);
    row-gap: clamp(1.5rem, 3.5vw, 2.5rem);
  }
  @media (min-width: 700px) {
    .trust-clean__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .trust-clean__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .trust-clean__item-title {
    margin: 0 0 0.55rem;
    font-size: 1.02rem;
    font-weight: 650;
    line-height: 1.25;
    color: #1b1b1b;
    transition: color 0.2s ease;
  }
  .trust-clean__item-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #757575;
    transition: color 0.2s ease;
  }

  /* Premium subtle hover: text darkens slightly */
  .trust-clean__item:hover .trust-clean__item-title {
    color: #111111;
  }
  .trust-clean__item:hover .trust-clean__item-text {
    color: #555555;
  }
</style>

{% schema %}
{
  "name": "Trust clean",
  "tag": "section",
  "class": "section-trust-clean",
  "settings": [
    {
      "type": "header",
      "content": "Top trust bar"
    },
    {
      "type": "checkbox",
      "id": "show_top_bar",
      "label": "Show top trust bar",
      "default": true
    },
    {
      "type": "text",
      "id": "top_bar_text",
      "label": "Top bar text",
      "default": "Free shipping over R500 • Easy 14-day returns • Secure checkout"
    },
    {
      "type": "color",
      "id": "top_bar_bg",
      "label": "Top bar background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "top_bar_text_color",
      "label": "Top bar text color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Trust content block"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why shop with us"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Fast shipping, easy returns, and secure checkout on every order."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "trust_column",
      "name": "Trust column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast dispatch"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Orders ship within 1–3 business days."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Trust clean",
      "blocks": [
        {
          "type": "trust_column",
          "settings": {
            "title": "Fast dispatch",
            "text": "Orders ship within 1–3 business days."
          }
        },
        {
          "type": "trust_column",
          "settings": {
            "title": "Easy returns",
            "text": "Hassle-free returns within 14 days."
          }
        },
        {
          "type": "trust_column",
          "settings": {
            "title": "Secure checkout",
            "text": "Encrypted payments you can trust."
          }
        },
        {
          "type": "trust_column",
          "settings": {
            "title": "Quality first",
            "text": "Curated pieces built for everyday wear."
          }
        }
      ]
    }
  ]
}
{% endschema %}
