<section class="popup-newsletter-section" data-popup-enabled="{{ section.settings.enable_popup }}">
  <div class="popup-newsletter" id="newsletter-popup-{{ section.id }}" aria-hidden="true">
    <div class="popup-newsletter__overlay" data-popup-close></div>
    <div class="popup-newsletter__content" role="dialog" aria-modal="true" aria-label="Newsletter signup">
      <button class="popup-newsletter__close" data-popup-close aria-label="Close popup">&times;</button>
      {%- if section.settings.popup_image != blank -%}
        <div class="popup-newsletter__image">
          <img src="{{ section.settings.popup_image | image_url: width: 700 }}" alt="{{ section.settings.heading | default: 'Newsletter' | escape }}" loading="lazy">
        </div>
      {%- endif -%}
      <div class="popup-newsletter__form-wrapper">
        <h3>{{ section.settings.heading | default: 'GET 15% OFF' }}</h3>
        <p>{{ section.settings.subheading | default: 'Subscribe for exclusive drops and your first order discount.' }}</p>
        {%- form 'customer', class: 'popup-newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}" required>
          <button type="submit">{{ section.settings.button_text | default: 'SUBSCRIBE' }}</button>
        {%- endform -%}
        <p class="popup-newsletter__privacy">{{ section.settings.privacy_text | default: 'We respect your privacy. Unsubscribe anytime.' }}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .popup-newsletter { position: fixed; inset: 0; z-index: 100002; visibility: hidden; opacity: 0; transition: opacity 0.25s ease; }
  .popup-newsletter[aria-hidden="false"] { visibility: visible; opacity: 1; }
  .popup-newsletter__overlay { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.6); }
  .popup-newsletter__content {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: min(94vw, 760px); background: #0f0f0f; border: 1px solid rgba(255,255,255,0.12); border-radius: 16px;
    display: grid; grid-template-columns: 1fr 1fr; overflow: hidden;
  }
  .popup-newsletter__close { position: absolute; top: 0.65rem; right: 0.65rem; z-index: 2; background: transparent; border: none; color: #fff; font-size: 1.4rem; cursor: pointer; }
  .popup-newsletter__image img { width: 100%; height: 100%; object-fit: cover; display: block; min-height: 380px; }
  .popup-newsletter__form-wrapper { padding: 2rem 1.5rem; color: #f5f5f0; display: flex; flex-direction: column; justify-content: center; }
  .popup-newsletter__form-wrapper h3 { font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 0.5rem 0; }
  .popup-newsletter__form-wrapper p { margin: 0 0 1rem 0; color: rgba(245,245,240,0.78); }
  .popup-newsletter__form { display: flex; gap: 0; margin-bottom: 0.8rem; }
  .popup-newsletter__form input { flex: 1; border: 1px solid rgba(255,255,255,0.2); border-right: none; background: rgba(255,255,255,0.06); color: #f5f5f0; padding: 0.75rem 0.85rem; }
  .popup-newsletter__form button { border: none; background: var(--color-accent, #FF3333); color: #fff; padding: 0.75rem 1rem; font-weight: 700; cursor: pointer; }
  .popup-newsletter__privacy { font-size: 0.74rem; color: rgba(245,245,240,0.62); }
  @media (max-width: 768px) {
    .popup-newsletter__content { grid-template-columns: 1fr; }
    .popup-newsletter__image { display: none; }
  }
</style>

<script>
  (function() {
    var root = document.querySelector('.popup-newsletter-section[data-popup-enabled]');
    if (!root) return;
    if (root.getAttribute('data-popup-enabled') !== 'true') return;

    var popup = document.getElementById('newsletter-popup-{{ section.id }}');
    if (!popup) return;

    var seenKey = 'elovyn_popup_seen';
    var hasSeen = localStorage.getItem(seenKey);
    function openPopup() { popup.setAttribute('aria-hidden', 'false'); }
    function closePopup() { popup.setAttribute('aria-hidden', 'true'); localStorage.setItem(seenKey, 'true'); }

    popup.querySelectorAll('[data-popup-close]').forEach(function(el) {
      el.addEventListener('click', closePopup);
    });

    if (!hasSeen) {
      setTimeout(openPopup, 5000);
      if (window.innerWidth > 768) {
        document.addEventListener('mouseout', function(e) {
          if (e.clientY < 10 && !localStorage.getItem(seenKey)) openPopup();
        });
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Popup newsletter",
  "settings": [
    { "type": "checkbox", "id": "enable_popup", "label": "Enable popup", "default": false },
    { "type": "image_picker", "id": "popup_image", "label": "Popup image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "GET 15% OFF" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Subscribe for exclusive drops and your first order discount." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "SUBSCRIBE" },
    { "type": "text", "id": "privacy_text", "label": "Privacy text", "default": "We respect your privacy. Unsubscribe anytime." }
  ],
  "presets": [
    { "name": "Popup newsletter" }
  ]
}
{% endschema %}
