<section class="elite-image-text section-spacing">
  <div class="container">
    {% for block in section.blocks %}
      <div class="elite-image-text__row{% if forloop.index0 | modulo: 2 == 1 %} elite-image-text__row--reverse{% endif %}" {{ block.shopify_attributes }}>
        <div class="elite-image-text__media">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
          {% else %}
            <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=1600&q=80" alt="{{ block.settings.heading | escape }}" loading="lazy" width="1600" height="1000">
          {% endif %}
        </div>
        <div class="elite-image-text__content">
          <h3>{{ block.settings.heading | default: "Crafted for movement" }}</h3>
          <p>{{ block.settings.text | default: "Tell your brand story with strong visual sections tailored to your audience." }}</p>
          {% if block.settings.button_text != blank %}
            <a href="{{ block.settings.button_link | default: '/collections/all' }}" class="elite-image-text__btn">{{ block.settings.button_text }}</a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>
<style>
  .elite-image-text__row{display:grid;grid-template-columns:1fr;gap:1rem;align-items:center;margin-bottom:1.5rem}
  @media(min-width:980px){.elite-image-text__row{grid-template-columns:1.1fr .9fr;gap:1.5rem}.elite-image-text__row--reverse{grid-template-columns:.9fr 1.1fr}.elite-image-text__row--reverse .elite-image-text__media{order:2}.elite-image-text__row--reverse .elite-image-text__content{order:1}}
  .elite-image-text__media{overflow:hidden}
  .elite-image-text__media img{display:block;width:100%;height:100%;min-height:340px;object-fit:cover}
  .elite-image-text__content h3{margin:0 0 .6rem;font-size:clamp(1.25rem,3vw,2rem);text-transform:uppercase}
  .elite-image-text__content p{margin:0 0 .95rem;color:rgba(0,0,0,.68);line-height:1.6}
  .elite-image-text__btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 1rem;border:1px solid #000;background:#000;color:#fff;text-decoration:none;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em}
</style>

{% schema %}
{
  "name": "Image with text split",
  "blocks": [
    {
      "type": "item",
      "name": "Image + text",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted for movement" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Tell your brand story with strong visual sections tailored to your audience." },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Image with text split", "blocks": [{ "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
